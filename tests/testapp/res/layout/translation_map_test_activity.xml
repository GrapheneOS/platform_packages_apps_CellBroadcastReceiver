<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_select_language"
        android:textSize="18sp"
        android:textStyle="bold"/>

    <RadioGroup
        android:id="@+id/language_radio_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/lang_en"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/button_send_emergency_alerts_in_english"
            android:checked="true"/>
        <RadioButton
            android:id="@+id/lang_ko"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/button_send_emergency_alerts_in_korean"/>
        <RadioButton
            android:id="@+id/lang_zh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/button_send_emergency_alerts_in_chinese"/>
        <RadioButton
            android:id="@+id/lang_ja"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/button_send_emergency_alerts_in_japanese"/>
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_geolocation_options"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"/>

    <RadioGroup
        android:id="@+id/geometry_radio_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/geo_none"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/option_no_geolocation"
            android:checked="true"/>
        <RadioButton
            android:id="@+id/geo_circle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/option_include_geolocation_in_circle"/>
        <RadioButton
            android:id="@+id/geo_polygon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/option_include_geolocation_in_polygon"/>
        <RadioButton
            android:id="@+id/geo_mixed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/option_include_geolocation_mixed"/>
    </RadioGroup>

    <CheckBox
        android:id="@+id/delay_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/button_delay_broadcast" />

    <Button
        android:id="@+id/send_alert_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/button_send_test_alert"/>
</LinearLayout>
