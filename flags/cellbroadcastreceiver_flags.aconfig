package: "com.android.cellbroadcastreceiver.flags"
container: "com.android.cellbroadcast"

flag {
    name: "test_flag"
    namespace: "cellbroadcast"
    description: "Test flag for cellbroadcastreceiver"
    bug: "343345283"
}

flag {
    name: "enable_cellbroadcast_map_viewer"
    namespace: "cellbroadcast"
    description: "If enabled, for alerts that include geolocation information, the warning area and my current location are displayed in a webview."
    bug: "410738387"
}

flag {
    name: "enable_cellbroadcast_translation"
    namespace: "cellbroadcast"
    description: "If enabled, and the system language and alert language are different, the translation will be provided to match the system language."
    bug: "412566436"
}

flag {
    name: "enable_cellbroadcast_language_translation"
    namespace: "cellbroadcast"
    description: "If enabled, and the system language and alert language are different, the language translation will be provided to match the system language."
    bug: "496356701"
}
